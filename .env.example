# FlowForge environment template
#
# Copy values into your deployment provider's secure environment-variable UI or into a
# local, gitignored `.env` file. The local binary loads `.env` at startup. Never commit real
# API keys, tokens, passwords, signing seeds, or private repository URLs.

# ---------------------------------------------------------------------------
# Local server
# ---------------------------------------------------------------------------
# The Rust server binds to 127.0.0.1 and accepts --port from the CLI.
# Example:
#   openfab serve --repo demo/.work/web --port 8787 --policy policy/trust.json
FLOWFORGE_PUBLIC_URL=

# ---------------------------------------------------------------------------
# LLM backend used by the Rust server
# ---------------------------------------------------------------------------
# Default: local `claude` CLI for compatibility. If you only have OpenAI or Groq,
# set this to `openai` or `groq` and fill the three variables in that provider block.
# Alternatives: `ollama`, `dashscope`, or `qwen`.
OPENFAB_LLM=claude

# Claude CLI / Codex CLI overrides
OPENFAB_CLAUDE_BIN=
OPENFAB_CLAUDE_MODEL=
OPENFAB_CLAUDE_TIMEOUT_SECS=
OPENFAB_CODEX_BIN=
OPENFAB_CODEX_MODEL=
# Codex exec defaults to a read-only sandbox. Use workspace-write only when required.
OPENFAB_CODEX_SANDBOX=read-only
OPENFAB_CODEX_APPROVAL_POLICY=never
# Keep disabled unless the process runs inside a deliberately isolated container.
OPENFAB_CODEX_ALLOW_DANGEROUS=0

# Ollama or OpenAI-compatible endpoint
OPENFAB_OLLAMA_URL=
OPENFAB_OLLAMA_MODEL=
OPENFAB_OLLAMA_KEY=

# OpenAI-compatible hosted providers. Set OPENFAB_LLM to the provider name above.
# Minimum OpenAI setup: OPENFAB_LLM=openai, OPENAI_API_KEY, OPENFAB_OPENAI_MODEL.
# Minimum Groq setup: OPENFAB_LLM=groq, GROQ_API_KEY, OPENFAB_GROQ_MODEL.
OPENAI_API_KEY=
OPENFAB_OPENAI_MODEL=
GROQ_API_KEY=
OPENFAB_GROQ_MODEL=

# DashScope / Qwen
DASHSCOPE_API_KEY=
OPENFAB_DASHSCOPE_MODEL=

# ---------------------------------------------------------------------------
# Native agent-base adapters
# ---------------------------------------------------------------------------
OPENFAB_HOME=
OPENFAB_AGENTSCOPE_URL=
OPENFAB_HICLAW_URL=
OPENFAB_AGENTCHAT_URL=
OPENFAB_OPENHANDS_URL=

# Agent-chat integration server
AGENTCHAT_ADAPTER_HOST=
AGENTCHAT_ADAPTER_PORT=
AGENTCHAT_BACKEND_URL=
AGENTCHAT_LLM_ENDPOINT=
AGENTCHAT_LLM_KEY=
AGENTCHAT_LLM_MODEL=
AGENTCHAT_LLM_MAX_TOKENS=
AGENTCHAT_LLM_TEMPERATURE=
AGENTCHAT_NATIVE_MODE=

# HiClaw integration server
OPENFAB_HICLAW_ADMIN_USER=
OPENFAB_HICLAW_ADMIN_PASSWORD=
OPENFAB_HICLAW_CONTROLLER_BASE=
OPENFAB_HICLAW_TOKEN=
OPENFAB_HICLAW_MATRIX_BASE=
OPENFAB_HICLAW_MINIO_ENDPOINT=
OPENFAB_HICLAW_MINIO_ACCESS_KEY=
OPENFAB_HICLAW_MINIO_SECRET_KEY=
OPENFAB_HICLAW_MODEL=

# ---------------------------------------------------------------------------
# Live forge adapters
# ---------------------------------------------------------------------------
# If unset, FlowForge falls back to local git instances for demo/provenance flows.
OPENFAB_GITHUB_REMOTE=

OPENFAB_FORGEJO_URL=
OPENFAB_FORGEJO_TOKEN=
OPENFAB_FORGEJO_REPO=

OPENFAB_GITEA_URL=
OPENFAB_GITEA_TOKEN=
OPENFAB_GITEA_REPO=

OPENFAB_GITCODE_URL=
OPENFAB_GITCODE_TOKEN=
OPENFAB_GITCODE_REPO=
